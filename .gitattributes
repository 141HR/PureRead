# Auto detect text files and normalize line endings conservatively
* text=auto

# Windows scripts and batch files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts
*.sh text eol=lf

# Generated lockfile
pubspec.lock linguist-generated=true

# Binary assets and artifacts
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary
*.zip binary
*.ttf binary
*.otf binary
*.jks binary
*.keystore binary
*.dll binary
*.so binary
